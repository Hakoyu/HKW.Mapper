<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.3.8</Version>
    <Company>HKW</Company>
    <Authors>HKW</Authors>
    <PackageDescription>High-performance Mapper with SourceGenerator</PackageDescription>
    <PackageTags>Mapper;SourceGenerator</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>HKW.Mapper</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--<IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>-->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeGeneratorAnalyzers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <PathMap Condition="'$(SolutionDir)' != ''">$(SolutionDir)=/_/</PathMap>
    <PathMap Condition="'$(SolutionDir)' == ''"
      >$(MSBuildProjectDirectory)=/_/$(AssemblyName)/</PathMap>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\HKW.Mapper.Generators\HKW.Mapper.Generators.csproj"
      ReferenceOutputAssembly="false"
    />
    <!-- 仅用于将 HKW.SourceGeneratorUtils.dll 打包进 analyzers/dotnet/cs, 不作为运行时程序集引用 -->
    <PackageReference
      Include="HKW.SourceGeneratorUtils"
      Version="0.2.3"
      PrivateAssets="all"
      ExcludeAssets="all"
      GeneratePathProperty="true"
    />
  </ItemGroup>

  <Target Name="IncludeGeneratorAnalyzers">
    <PropertyGroup>
      <GeneratorAssemblyPath>..\HKW.Mapper.Generators\bin\$(Configuration)\netstandard2.0\HKW.Mapper.Generators.dll</GeneratorAssemblyPath>
    </PropertyGroup>

    <Error
      Text="Generator assembly not found at $(GeneratorAssemblyPath). Ensure HKW.Mapper.Generators is built before packing."
      Condition="!Exists('$(GeneratorAssemblyPath)')"
    />

    <ItemGroup>
      <!-- 必须将源生成器及辅助库 dll 导入 NuGet 分析器目录, 否则 NuGet 无法使用源生成 -->
      <TfmSpecificPackageFile
        Include="$(GeneratorAssemblyPath)"
        PackagePath="analyzers/dotnet/cs/HKW.Mapper.Generators.dll"
      />
      <TfmSpecificPackageFile
        Include="$(PkgHKW_SourceGeneratorUtils)\lib\netstandard2.0\HKW.SourceGeneratorUtils.dll"
        PackagePath="analyzers/dotnet/cs/HKW.SourceGeneratorUtils.dll"
      />
    </ItemGroup>
  </Target>
</Project>
